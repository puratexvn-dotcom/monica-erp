'use client';

// ============================================================================
// MONICA GARMENT ERP — Layout chung khu dashboard
// Sidebar + Header (Breadcrumb, Bộ lọc thời gian, Fast-Search, Thông báo)
// ============================================================================

import { useEffect, useMemo, useState } from 'react';
import { usePathname, useRouter } from 'next/navigation';
import {
  Menu, Search, Bell, ChevronRight, CalendarClock, Factory,
  AlertTriangle, Info, AlertOctagon, CheckCheck,
} from 'lucide-react';
import Sidebar, { NAV_ITEMS } from '@/components/sidebar';
import { getSession, type Session } from '@/lib/auth';
import { fetchTable, updateRow } from '@/lib/supabase';
import { TimeFilterContext, TIME_LABEL, type TimeRange } from '@/lib/hooks';
import { fmtDateTime } from '@/lib/garment-math';
import type { Order, AppNotification } from '@/types/erp';

export default function DashboardLayout({ children }: { children: React.ReactNode }) {
  const router = useRouter();
  const pathname = usePathname();

  const [session, setSession] = useState<Session | null>(null);
  const [checked, setChecked] = useState(false);
  const [collapsed, setCollapsed] = useState(false);
  const [mobileOpen, setMobileOpen] = useState(false);
  const [range, setRange] = useState<TimeRange>('all');

  const [orders, setOrders] = useState<Order[]>([]);
  const [notifs, setNotifs] = useState<AppNotification[]>([]);
  const [search, setSearch] = useState('');
  const [notifOpen, setNotifOpen] = useState(false);

  // Guard đăng nhập
  useEffect(() => {
    const s = getSession();
    if (!s) {
      router.replace('/login');
      return;
    }
    setSession(s);
    setChecked(true);
  }, [router]);

  // Dữ liệu cho Fast-Search + Thông báo
  useEffect(() => {
    if (!session) return;
    fetchTable<Order>('orders').then((r) => setOrders(r.rows));
    fetchTable<AppNotification>('notifications').then((r) => {
      const role = session.user.role;
      setNotifs(
        r.rows.filter((n) => role === 'superadmin' || (Array.isArray(n.roles) && n.roles.includes(role))),
      );
    });
  }, [session]);

  const crumb = useMemo(() => {
    const item = NAV_ITEMS.find((n) => pathname.startsWith(n.path));
    return item?.label ?? 'Tổng quan';
  }, [pathname]);

  const searchResults = useMemo(() => {
    const q = search.trim().toLowerCase();
    if (!q) return [];
    return orders
      .filter((o) =>
        [o.po_code, o.product_name, o.brand].some((s) => String(s || '').toLowerCase().includes(q)),
      )
      .slice(0, 6);
  }, [search, orders]);

  const unread = notifs.filter((n) => !n.read).length;

  const markAllRead = () => {
    notifs.filter((n) => !n.read).forEach((n) => { void updateRow('notifications', n.id, { read: true }); });
    setNotifs((prev) => prev.map((n) => ({ ...n, read: true })));
  };

  if (!checked || !session) {
    return (
      <div className="flex min-h-screen items-center justify-center">
        <div className="flex items-center gap-3 text-slate-400">
          <Factory className="h-6 w-6 animate-pulse text-indigo-500" />
          <span className="text-sm font-medium">Đang kiểm tra phiên đăng nhập…</span>
        </div>
      </div>
    );
  }

  return (
    <div className="flex min-h-screen">
      <Sidebar
        session={session}
        collapsed={collapsed}
        onToggleCollapse={() => setCollapsed((v) => !v)}
        mobileOpen={mobileOpen}
        onCloseMobile={() => setMobileOpen(false)}
      />

      <div className="flex min-w-0 flex-1 flex-col">
        {/* ── HEADER ── */}
        <header className="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur">
          <div className="flex items-center gap-3 px-4 py-3 sm:px-6">
            <button onClick={() => setMobileOpen(true)} className="rounded-lg p-2 text-slate-500 hover:bg-slate-100 lg:hidden">
              <Menu className="h-5 w-5" />
            </button>

            {/* Breadcrumb */}
            <div className="hidden items-center gap-1.5 text-sm sm:flex">
              <span className="font-semibold text-slate-400">MONICA ERP</span>
              <ChevronRight className="h-4 w-4 text-slate-300" />
              <span className="font-bold text-slate-800">{crumb}</span>
            </div>

            {/* Fast-Search */}
            <div className="relative ml-auto w-full max-w-xs">
              <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
              <input
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                placeholder="Tìm PO, sản phẩm, nhãn hàng…"
                className="w-full rounded-lg border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-sm text-slate-700 placeholder:text-slate-400 focus:border-indigo-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-100"
              />
              {searchResults.length > 0 && (
                <div className="absolute left-0 right-0 top-full z-40 mt-1.5 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl">
                  {searchResults.map((o) => (
                    <button key={o.id} onClick={() => setSearch('')}
                      className="flex w-full items-center justify-between gap-3 px-3.5 py-2.5 text-left transition hover:bg-slate-50">
                      <span>
                        <span className="block text-sm font-semibold text-indigo-700">{o.po_code}</span>
                        <span className="block truncate text-xs text-slate-500">{o.brand} · {o.product_name}</span>
                      </span>
                      <span className="shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-500">
                        {o.status}
                      </span>
                    </button>
                  ))}
                </div>
              )}
            </div>

            {/* Bộ lọc thời gian */}
            <div className="hidden items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 shadow-sm md:flex">
              <CalendarClock className="h-4 w-4 text-slate-400" />
              <select value={range} onChange={(e) => setRange(e.target.value as TimeRange)}
                className="bg-transparent text-sm font-medium text-slate-700 focus:outline-none">
                {(Object.keys(TIME_LABEL) as TimeRange[]).map((k) => (
                  <option key={k} value={k}>{TIME_LABEL[k]}</option>
                ))}
              </select>
            </div>

            {/* Thông báo */}
            <div className="relative">
              <button onClick={() => setNotifOpen((v) => !v)}
                className="relative rounded-lg p-2 text-slate-500 transition hover:bg-slate-100">
                <Bell className="h-5 w-5" />
                {unread > 0 && (
                  <span className="absolute -right-0.5 -top-0.5 flex h-4.5 min-w-[18px] h-[18px] items-center justify-center rounded-full bg-rose-500 px-1 text-[10px] font-bold text-white">
                    {unread}
                  </span>
                )}
              </button>
              {notifOpen && (
                <div className="absolute right-0 top-full z-40 mt-1.5 w-80 max-w-[90vw] overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl">
                  <div className="flex items-center justify-between border-b border-slate-100 px-4 py-2.5">
                    <p className="text-xs font-bold uppercase tracking-wide text-slate-500">Thông báo</p>
                    <button onClick={markAllRead} className="inline-flex items-center gap-1 text-xs font-medium text-indigo-600 hover:underline">
                      <CheckCheck className="h-3.5 w-3.5" /> Đã đọc hết
                    </button>
                  </div>
                  <div className="max-h-80 overflow-y-auto">
                    {notifs.length === 0 && <p className="px-4 py-8 text-center text-sm text-slate-400">Không có thông báo</p>}
                    {notifs.map((n) => (
                      <div key={n.id} className={`flex gap-2.5 border-b border-slate-50 px-4 py-3 ${n.read ? 'opacity-60' : ''}`}>
                        {n.severity === 'critical'
                          ? <AlertOctagon className="mt-0.5 h-4 w-4 shrink-0 text-rose-500" />
                          : n.severity === 'warning'
                            ? <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0 text-amber-500" />
                            : <Info className="mt-0.5 h-4 w-4 shrink-0 text-indigo-400" />}
                        <div className="min-w-0">
                          <p className="text-xs leading-relaxed text-slate-700">{n.message}</p>
                          <p className="mt-0.5 text-[10px] text-slate-400">{fmtDateTime(n.created_at)}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </div>

          {/* Bộ lọc thời gian bản mobile */}
          <div className="flex gap-1.5 overflow-x-auto px-4 pb-2.5 md:hidden">
            {(Object.keys(TIME_LABEL) as TimeRange[]).map((k) => (
              <button key={k} onClick={() => setRange(k)}
                className={`shrink-0 rounded-full px-3 py-1 text-xs font-semibold transition ${
                  range === k ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-500'
                }`}>
                {TIME_LABEL[k]}
              </button>
            ))}
          </div>
        </header>

        {/* ── NỘI DUNG MODULE ── */}
        <TimeFilterContext.Provider value={range}>
          <main className="mx-auto w-full max-w-7xl flex-1 px-4 py-5 sm:px-6">{children}</main>
        </TimeFilterContext.Provider>

        <footer className="px-6 py-5 text-center text-xs text-slate-400">
          MONICA Garment ERP · Đồng bộ realtime Supabase · {new Date().getFullYear()}
        </footer>
      </div>
    </div>
  );
}
