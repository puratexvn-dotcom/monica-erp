'use client';

// ============================================================================
// MONICA GARMENT ERP — Trang Đăng nhập (10 tài khoản tiêu chuẩn)
// ⚠️ Danh sách tài khoản demo hiển thị để trình diễn — GỠ BỎ ở production.
// ============================================================================

import { useState, type FormEvent } from 'react';
import { useRouter } from 'next/navigation';
import { Factory, Lock, UserRound, LogIn, AlertTriangle, Loader2, ShieldCheck } from 'lucide-react';
import { login, saveSession, ROLE_HOME, ROLE_LABEL } from '@/lib/auth';
import { MOCK_USERS } from '@/lib/mock-data';
import { inputCls, btnPrimary } from '@/components/ui';

export default function LoginPage() {
  const router = useRouter();
  const [username, setUsername] = useState('');
  const [password, setPassword] = useState('');
  const [error, setError] = useState('');
  const [loading, setLoading] = useState(false);

  const handleSubmit = async (e: FormEvent) => {
    e.preventDefault();
    setError('');
    setLoading(true);
    const user = await login(username, password);
    setLoading(false);
    if (!user) {
      setError('Sai tên đăng nhập hoặc mật khẩu, hoặc tài khoản đã bị khóa.');
      return;
    }
    saveSession(user);
    router.replace(ROLE_HOME[user.role]);
  };

  const quickFill = (u: string, p: string) => {
    setUsername(u);
    setPassword(p);
    setError('');
  };

  return (
    <div className="flex min-h-screen">
      {/* Panel trái — branding (ẩn trên mobile) */}
      <div className="relative hidden w-1/2 flex-col justify-between overflow-hidden bg-gradient-to-br from-indigo-600 via-indigo-700 to-violet-800 p-10 text-white lg:flex">
        <div className="flex items-center gap-3">
          <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-white/15 backdrop-blur">
            <Factory className="h-6 w-6" />
          </div>
          <div>
            <p className="text-lg font-bold tracking-tight">MONICA ERP</p>
            <p className="text-xs text-indigo-200">Garment Smart System</p>
          </div>
        </div>
        <div>
          <h1 className="max-w-md text-3xl font-bold leading-tight">
            Quản trị Sản xuất Dệt may đa phân hệ
          </h1>
          <p className="mt-3 max-w-md text-sm leading-relaxed text-indigo-200">
            10 module đồng bộ dữ liệu 100%: PO &amp; BOM, Bàn cắt, Chuyền may, QA/AQL 2.5,
            Kho NPL – Thành phẩm, Công nợ Subcon, Cổng khách hàng.
          </p>
        </div>
        <p className="flex items-center gap-2 text-xs text-indigo-300">
          <ShieldCheck className="h-4 w-4" /> Phân quyền RBAC 10 vai trò · Realtime Supabase
        </p>
        <div className="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-white/10 blur-2xl" />
        <div className="pointer-events-none absolute -bottom-32 -left-16 h-80 w-80 rounded-full bg-violet-400/20 blur-3xl" />
      </div>

      {/* Panel phải — form */}
      <div className="flex w-full items-center justify-center bg-slate-50 p-5 lg:w-1/2">
        <div className="w-full max-w-md">
          <div className="mb-6 flex items-center gap-3 lg:hidden">
            <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-600">
              <Factory className="h-6 w-6 text-white" />
            </div>
            <div>
              <p className="text-lg font-bold tracking-tight text-slate-900">MONICA ERP</p>
              <p className="text-xs text-slate-500">Garment Smart System</p>
            </div>
          </div>

          <div className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
            <h2 className="text-xl font-bold text-slate-900">Đăng nhập hệ thống</h2>
            <p className="mt-1 text-sm text-slate-500">Nhập tài khoản được cấp theo vai trò của bạn.</p>

            <form onSubmit={handleSubmit} className="mt-6 space-y-4">
              <div>
                <span className="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500">Tên đăng nhập</span>
                <div className="relative">
                  <UserRound className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
                  <input value={username} onChange={(e) => setUsername(e.target.value)} autoComplete="username"
                    placeholder="vd: giamdoc" className={`${inputCls} pl-9`} />
                </div>
              </div>
              <div>
                <span className="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500">Mật khẩu</span>
                <div className="relative">
                  <Lock className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
                  <input type="password" value={password} onChange={(e) => setPassword(e.target.value)} autoComplete="current-password"
                    placeholder="••••••••" className={`${inputCls} pl-9`} />
                </div>
              </div>

              {error && (
                <div className="flex items-start gap-2 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2.5 text-sm text-rose-700">
                  <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0" /> {error}
                </div>
              )}

              <button type="submit" disabled={loading || !username || !password} className={`${btnPrimary} w-full py-2.5`}>
                {loading ? <Loader2 className="h-4 w-4 animate-spin" /> : <LogIn className="h-4 w-4" />}
                {loading ? 'Đang kiểm tra…' : 'Đăng nhập'}
              </button>
            </form>
          </div>

          {/* Tài khoản demo — bấm để điền nhanh */}
          <div className="mt-5 rounded-2xl border border-dashed border-slate-300 bg-white/60 p-4">
            <p className="mb-2.5 text-xs font-semibold uppercase tracking-wide text-slate-400">
              Tài khoản demo (bấm để điền nhanh)
            </p>
            <div className="grid grid-cols-2 gap-1.5 sm:grid-cols-3">
              {MOCK_USERS.map((u) => (
                <button key={u.id} onClick={() => quickFill(u.username, u.password)}
                  className="rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-left text-[11px] font-medium text-slate-600 shadow-sm transition hover:border-indigo-300 hover:text-indigo-600 active:scale-95">
                  <span className="block truncate font-semibold">{ROLE_LABEL[u.role]}</span>
                  <span className="block truncate text-slate-400">{u.username}</span>
                </button>
              ))}
            </div>
            <p className="mt-2.5 text-[11px] leading-relaxed text-slate-400">
              ⚠️ Cơ chế demo — bản production phải dùng Supabase Auth (mật khẩu băm) + RLS,
              và gỡ bỏ khối tài khoản demo này.
            </p>
          </div>
        </div>
      </div>
    </div>
  );
}
